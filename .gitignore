# personal saved comics - can be large (layer bitmaps) and are per-machine
projects/*.json
projects/*.json.tmp

# per-machine settings (personal paths stay out of the repo)
config.json

# personal asset library (your own drawn stamps)
assets/

# your learning record: curriculum progress + practice attempts
# (anchored to the repo root so it does NOT match app/learn/, the code)
/learn/

# local reference library default location
drawing-resources/

# OS noise
Thumbs.db
Desktop.ini

# python
__pycache__/
*.pyc
